function Byakuro:SetupAutoRefresh()
    local lastUpdate = 0
    local updateDebounce = false
    
    coroutine.wrap(function()
        while self.UI and self.UI.ScreenGui and self.UI.ScreenGui.Parent do
            local now = tick()
            
            if now - lastUpdate > 0.5 and not updateDebounce then
                updateDebounce = true
                
                self:RefreshUserList()
                self:RefreshMessages()
                
                if self.UI.UpdateIndicator then
                    self.UI.UpdateIndicator.Size = UDim2.new(1, 0, 0, 2)
                    self.UI.UpdateIndicator.Visible = true
                    
                    task.delay(0.2, function()
                        if self.UI.UpdateIndicator then
                            self.UI.UpdateIndicator.Visible = false
                        end
                    end)
                end
                
                lastUpdate = now
                updateDebounce = false
            end
            
            task.wait(0.1)
        end
    end)()
end

