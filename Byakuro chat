function Byakuro:Start()
    self:CreateUI()
    self:ShowNotification("Chat Ready! (Delta Only)")
    self:SetupAutoRefresh()
    self:RefreshUserList()
    
    self.UI.MainFrame.TitleBar.Close.MouseButton1Click:Connect(function()
        self.UI.ScreenGui:Destroy()
        self.UI = nil
    end)
    
    self.UI.Input.Send.MouseButton1Click:Connect(function()
        local message = self.UI.InputBox.Text
        if message and #message > 0 then
            self:ShowNotification("Sent: " .. message)
            self.UI.InputBox.Text = ""
        end
    end)
    
    self.UI.InputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local message = self.UI.InputBox.Text
            if message and #message > 0 then
                self:ShowNotification("Sent: " .. message)
                self.UI.InputBox.Text = ""
            end
        end
    end)
    
    for tabName, button in pairs(self.UI.TabButtons) do
        button.MouseButton1Click:Connect(function()
            for name, btn in pairs(self.UI.TabButtons) do
                btn.TextColor3 = Color3.fromRGB(150, 150, 150)
            end
            button.TextColor3 = Color3.fromRGB(0, 170, 255)
            
            if tabName == "خاص" then
                self:RefreshUserList()
            elseif tabName == "جماعي" then
                self:ShowNotification("Group chat coming soon")
            elseif tabName == "المكتشفون" then
                self:ShowNotification("Scanning for script users...")
            end
        end)
    end
    
    if IS_MOBILE then
        local dragging = false
        local dragInput, dragStart, startPos
        
        self.UI.MainFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = self.UI.MainFrame.Position
                
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        
        self.UI.MainFrame.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                self.UI.MainFrame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
    end
end

