-- 3. إضافة اللاعبين للقائمة
local function AddPlayersToList(playersFrame)
    playersFrame:ClearAllChildren()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerBtn = Instance.new("TextButton")
            playerBtn.Size = UDim2.new(1, -10, 0, 40)
            playerBtn.Position = UDim2.new(0, 5, 0, #playersFrame:GetChildren() * 45)
            playerBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            playerBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            playerBtn.Text = "👤 " .. player.Name
            playerBtn.Font = Enum.Font.Gotham
            playerBtn.TextSize = 14
            playerBtn.TextXAlignment = Enum.TextXAlignment.Left
            playerBtn.Parent = playersFrame
            
            playerBtn.MouseButton1Click:Connect(function()
                -- عند الضغط على لاعب
                local selectedMsg = Instance.new("TextLabel")
                selectedMsg.Text = "→ اخترت: " .. player.Name
                selectedMsg.TextColor3 = Color3.fromRGB(255, 100, 150)
                selectedMsg.BackgroundTransparency = 1
                selectedMsg.Size = UDim2.new(1, -10, 0, 25)
                selectedMsg.Position = UDim2.new(0, 5, 0, #GUI.ChatFrame:GetChildren() * 30)
                selectedMsg.Font = Enum.Font.Gotham
                selectedMsg.TextSize = 14
                selectedMsg.TextXAlignment = Enum.TextXAlignment.Left
                selectedMsg.Parent = GUI.ChatFrame
                
                -- توجيه الكتابة للاعب
                GUI.InputBox.Text = "/w " .. player.Name .. " "
                GUI.InputBox:CaptureFocus()
            end)
        end
    end
end

-- 4. النظام الرئيسي
local function MainSystem()
    -- شاشة التحميل
    CreateLoadingScreen()
    task.wait(0.5)
    
    -- إنشاء الواجهة
    GUI = CreateMainGUI()
    
    -- تعبئة قائمة اللاعبين
    AddPlayersToList(GUI.PlayersFrame)
    
    -- أحداث الأزرار
    GUI.ToggleButton.MouseButton1Click:Connect(function()
        GUI.Window.Visible = not GUI.Window.Visible
    end)
    
    GUI.CloseButton.MouseButton1Click:Connect(function()
        GUI.Window.Visible = false
    end)
    
    GUI.SendButton.MouseButton1Click:Connect(function()
        local message = GUI.InputBox.Text
        if message and #message > 0 then
            -- إضافة للشات المحلي
            local msgLabel = Instance.new("TextLabel")
            msgLabel.Text = LocalPlayer.Name .. ": " .. message
            msgLabel.TextColor3 = Color3.fromRGB(100, 255, 100) -- أخضر للرسائل
            msgLabel.BackgroundTransparency = 1
            msgLabel.Size = UDim2.new(1, -10, 0, 25)
            msgLabel.Position = UDim2.new(0, 5, 0, #GUI.ChatFrame:GetChildren() * 30)
            msgLabel.Font = Enum.Font.Gotham
            msgLabel.TextSize = 14
            msgLabel.TextXAlignment = Enum.TextXAlignment.Left
            msgLabel.Parent = GUI.ChatFrame
            
            -- إرسال للعبة (بروكهافين)
            local success, err = pcall(function()
                local chatEvents = game:GetService("ReplicatedStorage"):WaitForChild("DefaultChatSystemChatEvents")
                chatEvents:WaitForChild("SayMessageRequest"):FireServer(message, "All")
            end)
            
            if not success then
                local errorMsg = Instance.new("TextLabel")
                errorMsg.Text = "[!] لا يمكن إرسال الرسالة"
                errorMsg.TextColor3 = Color3.fromRGB(255, 100, 100)
                errorMsg.BackgroundTransparency = 1
                errorMsg.Size = UDim2.new(1, -10, 0, 20)
                errorMsg.Position = UDim2.new(0, 5, 0, #GUI.ChatFrame:GetChildren() * 30)
                errorMsg.Font = Enum.Font.Gotham
                errorMsg.TextSize = 12
                errorMsg.Parent = GUI.ChatFrame
            end
            
            GUI.InputBox.Text = ""
        end
    end)
    
    -- إرسال عند الضغط على Enter
    GUI.InputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            GUI.SendButton.MouseButton1Click:Fire()
        end
    end)
    
    -- تحديث قائمة اللاعبين
    Players.PlayerAdded:Connect(function()
        task.wait(1)
        AddPlayersToList(GUI.PlayersFrame)
    end)
    
    Players.PlayerRemoving:Connect(function()
        AddPlayersToList(GUI.PlayersFrame)
    end)
    
    -- اختصار لوحة المفاتيح
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.F9 then
            GUI.Window.Visible = not GUI.Window.Visible
        end
    end)
    
    print("====================================")
    print("✅ KRB Chat Loaded Successfully!")
    print("📱 Designed for Delta Mobile")
    print("🎮 Works in Brookhaven Only")
    print("⚡ Press 💬 button to open/close")
    print("⚡ Press F9 to toggle (if keyboard)")
    print("====================================")
    
    return true
end

-- 5. بدء التشغيل
local GUI = nil
local success, errorMsg = pcall(function()
    MainSystem()
end)

if not success then
    warn("❌ Error loading KRB Chat: " .. tostring(errorMsg))
    
    -- نسخة احتياطية بسيطة
    local backupGui = Instance.new("ScreenGui")
    backupGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    local simpleBtn = Instance.new("TextButton")
    simpleBtn.Text = "💬 فتح الشات"
    simpleBtn.Size = UDim2.new(0, 150, 0, 60)
    simpleBtn.Position = UDim2.new(0, 10, 0, 10)
    simpleBtn.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    simpleBtn.TextColor3 = Color3.fromRGB(255, 50, 100)
    simpleBtn.Font = Enum.Font.GothamBold
    simpleBtn.TextSize = 16
    simpleBtn.Parent = backupGui
    
    simpleBtn.MouseButton1Click:Connect(function()
        game:GetService("TextChatService"):Chat("/chat Hello from KRB!")
    end)
    
    print("⚠️ Loaded in Simple Mode - Button only")
end
