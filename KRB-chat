-- KRB Chat - Brookhaven Delta Edition (No Sticker)
-- إصدار محسّن يعمل على الهاتف في بروكهافين

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

-- 1. شاشة تحميل بدون ستيكر
local function CreateLoadingScreen()
    local loadingGui = Instance.new("ScreenGui")
    loadingGui.Name = "KRBLoading"
    loadingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    loadingGui.ResetOnSpawn = false
    
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(1, 0, 1, 0)
    mainFrame.BackgroundColor3 = Color3.fromRGB(5, 5, 5) -- أسود غامق
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = loadingGui
    
    -- نص التحميل
    local loadingText = Instance.new("TextLabel")
    loadingText.Text = "جارٍ تحميل نظام الشات..."
    loadingText.Font = Enum.Font.GothamBold
    loadingText.TextSize = 22
    loadingText.TextColor3 = Color3.fromRGB(200, 200, 200)
    loadingText.BackgroundTransparency = 1
    loadingText.Size = UDim2.new(1, 0, 0, 30)
    loadingText.Position = UDim2.new(0, 0, 0.45, 0)
    loadingText.Parent = mainFrame
    
    -- شريط التحميل
    local loadBarBg = Instance.new("Frame")
    loadBarBg.Size = UDim2.new(0.6, 0, 0, 6)
    loadBarBg.Position = UDim2.new(0.2, 0, 0.5, 0)
    loadBarBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    loadBarBg.BorderSizePixel = 0
    loadBarBg.Parent = mainFrame
    
    local loadBar = Instance.new("Frame")
    loadBar.Size = UDim2.new(0, 0, 1, 0)
    loadBar.BackgroundColor3 = Color3.fromRGB(255, 50, 100) -- لون وردي غامق
    loadBar.BorderSizePixel = 0
    loadBar.Parent = loadBarBg
    
    loadingGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    -- تحميل متحرك
    for i = 1, 100 do
        loadBar.Size = UDim2.new(i/100, 0, 1, 0)
        loadingText.Text = "جارٍ تحميل نظام الشات... " .. i .. "%"
        RunService.RenderStepped:Wait()
    end
    
    task.wait(0.5)
    
    -- إخفاء الشاشة
    local tween = TweenService:Create(mainFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1})
    tween:Play()
    tween.Completed:Connect(function()
        loadingGui:Destroy()
        print("✅ تم تحميل نظام الشات بنجاح")
    end)
end

