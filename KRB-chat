-- 3. نظام إضافة الأشخاص
local function PopulatePlayersList(playersFrame)
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerButton = Instance.new("TextButton")
            playerButton.Size = UDim2.new(1, -10, 0, 40)
            playerButton.Position = UDim2.new(0, 5, 0, #playersFrame:GetChildren() * 45)
            playerButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            playerButton.TextColor3 = Color3.fromRGB(220, 220, 220)
            playerButton.Text = player.Name
            playerButton.Font = Enum.Font.Gotham
            playerButton.TextSize = 14
            playerButton.Parent = playersFrame
            
            playerButton.MouseButton1Click:Connect(function()
                -- عند الضغط على الشخص
                local message = Instance.new("TextLabel")
                message.Text = "تم تحديد: " .. player.Name
                message.TextColor3 = Color3.fromRGB(255, 105, 180)
                message.BackgroundTransparency = 1
                message.Size = UDim2.new(1, -10, 0, 30)
                message.Position = UDim2.new(0, 5, 0, #chatFrame:GetChildren() * 35)
                message.Font = Enum.Font.Gotham
                message.TextSize = 14
                message.Parent = chatFrame
            end)
        end
    end
end

-- 4. النظام الرئيسي
local function MainSystem()
    -- شاشة التحميل
    CreateLoadingScreen()
    wait(0.5)
    
    -- إنشاء الواجهة
    local GUI = CreateMainGUI()
    
    -- ملء قائمة الأشخاص
    PopulatePlayersList(GUI.PlayersFrame)
    
    -- زر التبديل
    GUI.ToggleButton.MouseButton1Click:Connect(function()
        GUI.Window.Visible = not GUI.Window.Visible
    end)
    
    -- زر الإرسال
    GUI.SendButton.MouseButton1Click:Connect(function()
        local messageText = GUI.InputBox.Text
        if messageText ~= "" and #messageText > 0 then
            -- إضافة الرسالة للشات
            local message = Instance.new("TextLabel")
            message.Text = LocalPlayer.Name .. ": " .. messageText
            message.TextColor3 = Color3.fromRGB(180, 255, 180)
            message.BackgroundTransparency = 1
            message.Size = UDim2.new(1, -10, 0, 30)
            message.Position = UDim2.new(0, 5, 0, #GUI.ChatFrame:GetChildren() * 35)
            message.Font = Enum.Font.Gotham
            message.TextSize = 14
            message.TextXAlignment = Enum.TextXAlignment.Left
            message.Parent = GUI.ChatFrame
            
            GUI.InputBox.Text = ""
            
            -- محاكاة إرسال الرسالة للعبة (للبروكهافين)
            game:GetService("ReplicatedStorage"):WaitForChild("DefaultChatSystemChatEvents"):WaitForChild("SayMessageRequest"):FireServer(messageText, "All")
        end
    end)
    
    -- إدخال بالإدخال
    GUI.InputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            GUI.SendButton.MouseButton1Click:Fire()
        end
    end)
    
    -- اختصارات لوحة المفاتيح
    local uis = game:GetService("UserInputService")
    uis.InputBegan:Connect(function(input, gameProcessed)
        if input.KeyCode == Enum.KeyCode.F9 then
            GUI.Window.Visible = not GUI.Window.Visible
        end
    end)
    
    -- تحديث قائمة الأشخاص
    Players.PlayerAdded:Connect(function(player)
        task.wait(1)
        -- إعادة تعبئة القائمة عند دخول لاعب جديد
        GUI.PlayersFrame:ClearAllChildren()
        PopulatePlayersList(GUI.PlayersFrame)
    end)
    
    Players.PlayerRemoving:Connect(function(player)
        -- إعادة تعبئة القائمة عند خروج لاعب
        GUI.PlayersFrame:ClearAllChildren()
        PopulatePlayersList(GUI.PlayersFrame)
    end)
    
    print("✅ KRB Chat Enhanced loaded successfully!")
    print("📱 Controls: F9 to toggle | Click players to select")
    print("🎮 Special for Brookhaven Delta Mobile")
    
    return GUI
end

-- 5. بدء النظام
local success, err = pcall(function()
    MainSystem()
end)

if not success then
    warn("❌ Error loading KRB Chat Enhanced: " .. err)
    
    -- نسخة احتياطية بسيطة
    local backupGui = Instance.new("ScreenGui")
    backupGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Text = "KRB Chat Loaded (Basic Mode)"
